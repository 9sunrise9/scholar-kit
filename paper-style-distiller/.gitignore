# Distillation pipeline run artifacts — regenerated by the scripts/ directory.
# These are large JSON / HTML outputs from real distill runs and should not
# be committed. Re-run `scripts/run_core5_bootstrap.py` etc. to regenerate.
runs/

# Source-paper binaries — the actual research papers, copyrighted.
# Keep only the preprocessed Markdown sidecars and the Zotero manifest .tsv
# under samples/. To pull the source PDFs, install the upstream Zotero
# collection described in samples/zotero-filter-preview.tsv.
samples/**/*.pdf
samples/**/**/*.pdf

# Python bytecode — covered by repo-level .gitignore, kept here as defense
# in depth in case this skill is vendored into a project that lacks it.
__pycache__/
*.pyc

# macOS Finder metadata — covered by repo-level .gitignore as well.
.DS_Store
